      "name": "auth",
      "item": [
        {
          "name": "Login (/api/v1/auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.accessToken);",
                  "    console.log(\"Token JWT atualizado automaticamente na coleção!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lucas@email.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{local}}/api/v1/auth",
              "host": [
                "{{local}}"
              ],
              "path": [
                "api",
                "v1",
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Role (/api/v1/auth/refresh-role)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"accessToken\": \"{{token}}\",\n    \"expiresIn\": 3600,\n    \"type\": \"Bearer\"\n}"
            },
            "url": {
              "raw": "{{local}}/api/v1/auth/refresh-role",
              "host": [
                "{{local}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh-role"
              ]
            }
          },
          "response": []
        }
      ]
